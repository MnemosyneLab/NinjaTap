<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:visibility="gone">

    <LinearLayout style="@style/NinjaTapPageContent">

        <TextView
            style="@style/NinjaTapPageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pairing_title" />

        <TextView
            style="@style/NinjaTapSubtext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/pairing_intro" />

        <LinearLayout
            android:id="@+id/pairing_pending"
            style="@style/NinjaTapCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/hero_background">

            <ImageView
                style="@style/NinjaTapShortcutIcon"
                android:src="@drawable/ic_pairing" />

            <TextView
                style="@style/NinjaTapHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/pairing_pending_title" />

            <TextView
                style="@style/NinjaTapSubtext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/pairing_pending" />

            <Button
                android:id="@+id/back_to_control"
                style="@style/NinjaTapTextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/back_to_control" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pairing_values"
            style="@style/NinjaTapCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <LinearLayout style="@style/NinjaTapValueRow">

                <LinearLayout style="@style/NinjaTapShortcutText">

                    <TextView
                        style="@style/NinjaTapValueLabel"
                        android:text="@string/label_url" />

                    <TextView
                        android:id="@+id/pairing_url"
                        style="@style/NinjaTapValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:breakStrategy="simple"
                        android:textIsSelectable="true" />
                </LinearLayout>

                <Button
                    android:id="@+id/copy_url"
                    style="@style/NinjaTapCopyButton"
                    android:contentDescription="@string/copy_url" />
            </LinearLayout>

            <View style="@style/NinjaTapDivider" />

            <LinearLayout style="@style/NinjaTapValueRow">

                <LinearLayout style="@style/NinjaTapShortcutText">

                    <TextView
                        style="@style/NinjaTapValueLabel"
                        android:text="@string/label_fingerprint" />

                    <TextView
                        android:id="@+id/pairing_fingerprint"
                        style="@style/NinjaTapValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:breakStrategy="simple"
                        android:textIsSelectable="true" />
                </LinearLayout>

                <Button
                    android:id="@+id/copy_fingerprint"
                    style="@style/NinjaTapCopyButton"
                    android:contentDescription="@string/copy_fingerprint" />
            </LinearLayout>

            <Button
                android:id="@+id/copy_config"
                style="@style/NinjaTapPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:contentDescription="@string/copy_config_description"
                android:text="@string/copy_config" />

            <TextView
                style="@style/NinjaTapSubtext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/pairing_config_hint" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
