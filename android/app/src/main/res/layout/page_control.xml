<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout style="@style/NinjaTapPageContent">

        <TextView
            style="@style/NinjaTapPageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/control_title" />

        <LinearLayout
            style="@style/NinjaTapCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/hero_background"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/status"
                        style="@style/NinjaTapLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:background="@drawable/status_background"
                        android:paddingHorizontal="11dp"
                        android:paddingVertical="5dp"
                        android:text="@string/status_stopped" />

                    <TextView
                        style="@style/NinjaTapHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/service_title"
                        android:textSize="22sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="84dp"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/control_illustration" />
            </LinearLayout>

            <TextView
                android:id="@+id/service_summary"
                style="@style/NinjaTapSubtext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/service_idle" />

            <Button
                android:id="@+id/action"
                style="@style/NinjaTapPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/action_start" />

            <TextView
                android:id="@+id/detail"
                style="@style/NinjaTapSubtext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/danger"
                android:textIsSelectable="true"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/open_pairing"
            style="@style/NinjaTapShortcut"
            android:layout_marginTop="18dp">

            <ImageView
                style="@style/NinjaTapShortcutIcon"
                android:src="@drawable/ic_pairing" />

            <LinearLayout style="@style/NinjaTapShortcutText">

                <TextView
                    style="@style/NinjaTapRowTitle"
                    android:text="@string/pairing_title" />

                <TextView
                    style="@style/NinjaTapRowSubtitle"
                    android:layout_marginStart="12dp"
                    android:text="@string/pairing_shortcut" />
            </LinearLayout>

            <ImageView style="@style/NinjaTapShortcutArrow" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/open_pin_settings"
            style="@style/NinjaTapShortcut"
            android:layout_marginTop="10dp">

            <ImageView
                style="@style/NinjaTapShortcutIcon"
                android:src="@drawable/ic_lock" />

            <LinearLayout style="@style/NinjaTapShortcutText">

                <TextView
                    style="@style/NinjaTapRowTitle"
                    android:text="@string/screen_control_title" />

                <TextView
                    android:id="@+id/control_pin_status"
                    style="@style/NinjaTapRowSubtitle"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <ImageView style="@style/NinjaTapShortcutArrow" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
